<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <aggregates>
        <calculatedFormula>IF(RowCount = 0, 0, CDF1:SUM / RowCount)</calculatedFormula>
        <datatype>percent</datatype>
        <description>Connected referrals as a share of all referrals sent.</description>
        <developerName>FORMULA1</developerName>
        <isActive>true</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>Conversion rate</masterLabel>
        <scale>1</scale>
    </aggregates>
    <columns>
        <field>CUST_NAME</field>
    </columns>
    <columns>
        <field>Referral__c.Partner_Status__c</field>
    </columns>
    <columns>
        <aggregateTypes>Sum</aggregateTypes>
        <field>CDF1</field>
    </columns>
    <customDetailFormulas>
        <calculatedFormula>IF(ISPICKVAL(Referral__c.Partner_Status__c, &quot;Connected&quot;), 1, 0)</calculatedFormula>
        <dataType>Double</dataType>
        <description>1 when the referral is Connected, otherwise 0.</description>
        <developerName>CDF1</developerName>
        <label>Connected</label>
        <scale>0</scale>
    </customDetailFormulas>
    <description>Referrals in versus Connected per agency, with the conversion rate (AC-08.2). Row-level formula, no schema change.</description>
    <format>Summary</format>
    <groupingsDown>
        <dateGranularity>None</dateGranularity>
        <field>Referral__c.Referring_Agency__c</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <name>Referral conversion by agency</name>
    <params>
        <name>co</name>
        <value>1</value>
    </params>
    <reportType>CustomEntity$Referral__c</reportType>
    <scope>organization</scope>
    <showDetails>false</showDetails>
    <showGrandTotal>true</showGrandTotal>
    <showSubTotals>true</showSubTotals>
    <timeFrameFilter>
        <dateColumn>CUST_CREATED_DATE</dateColumn>
        <interval>INTERVAL_LAST90</interval>
    </timeFrameFilter>
</Report>
