<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>PR_ABN_Format</fullName>
    <active>true</active>
    <description>002 Partner referral</description>
    <errorConditionFormula>AND(NOT(ISBLANK(ABN__c)), NOT(REGEX(ABN__c, &quot;[0-9]{11}&quot;)))</errorConditionFormula>
    <errorDisplayField>ABN__c</errorDisplayField>
    <errorMessage>ABN must be exactly 11 digits.</errorMessage>
</ValidationRule>
