<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>PR_Period_Format</fullName>
    <active>true</active>
    <description>002 Partner referral</description>
    <errorConditionFormula>NOT(REGEX(Period_Month__c, &quot;[0-9]{4}-(0[1-9]|1[0-2])&quot;))</errorConditionFormula>
    <errorDisplayField>Period_Month__c</errorDisplayField>
    <errorMessage>Period Month must be YYYY-MM.</errorMessage>
</ValidationRule>
